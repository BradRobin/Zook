# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:root@localhost:5432/zook

# JWT Configuration
JWT_SECRET_KEY=generate-secure-random-key-here-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration
CORS_ORIGINS=["http://localhost:3500","http://127.0.0.1:3500"]

# Application Environment
ENVIRONMENT=development
